  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login responde 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token de sesion capturado en variable authToken\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"session_token\");",
                  "    pm.expect(body.session_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.environment.set(\"authToken\", body.session_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\",\n    \"accepted_terms\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/session/login",
              "host": ["{{baseUrl}}"],
              "path": ["session", "login"]
            }
          },
          "response": []
        }
      ]
    },
