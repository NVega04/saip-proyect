DB_USER=root
DB_PASSWORD=tu_password
DB_HOST=db
DB_PORT=3306
DB_NAME=db_saip_proyect

# Seguridad: obligatorio, mínimo 32 caracteres. Genera uno con:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si alguna vez se usó el valor por defecto, rota el secreto (invalida sesiones).
JWT_SECRET=reemplaza_con_un_secreto_aleatorio_de_al_menos_32_caracteres

# Cifrado de NIT y teléfonos. Genera una clave con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotar, separa con comas: clave_nueva,clave_anterior (la primera cifra).
# Guárdalas en un gestor de secretos; perderlas impide leer los datos cifrados.
ENCRYPTION_KEY=reemplaza_con_una_clave_fernet_generada

# Orígenes CORS permitidos, separados por coma y sin barra final.
# Desarrollo: http://localhost:5173 | Producción: https://saip.lat
CORS_ORIGINS=http://localhost:5173,https://saip.lat

# Consultas SQL en logs: false por defecto (true solo para depuración puntual).
SQLALCHEMY_ECHO=false

# Rate limit global por IP. Las rutas sensibles tienen límites más estrictos.
RATE_LIMIT_DEFAULT=100/minute
# Solo se confía en X-Forwarded-For si la petición viene de una IP de esta lista.
# Ejemplo con nginx en el mismo host: TRUSTED_PROXY_HOSTS=127.0.0.1,::1
TRUSTED_PROXY_HOSTS=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@gmail.com
# Usa una contraseña de aplicación, nunca la contraseña real de la cuenta.
MAIL_PASSWORD=tu_app_password
MAIL_FROM=tucorreo@gmail.com
# En producción usa un gestor de secretos en lugar de variables planas.

# Sin barra final; todos los enlaces de correo se construyen desde aquí.
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
